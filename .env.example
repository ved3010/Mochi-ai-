# ===================================================================
# Furry AI / Desktop Cat - Environment Configuration
# ===================================================================

# 1. Groq Whisper API Key (Required for Voice Speech-to-Text)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=

# 2. AI Model API Key (Required for answering questions and AI reasoning)
# Get a free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# (Optional alternatives)
# OPENAI_API_KEY=
# AGENT_API_KEY=

# 3. Google Classroom & Gmail OAuth Credentials (Required for Classroom + Gmail sync)
# Setup steps:
# 1. Go to Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Enable "Google Classroom API" and "Gmail API" under APIs & Services > Library
# 3. Credentials > Create Credentials > OAuth client ID > Application type: "Desktop app"
# 4. Paste your Client ID and Secret below:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
